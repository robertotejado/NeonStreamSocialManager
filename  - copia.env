# ══════════════════════════════════════════════════════════════════════════════
#  NeonStream Social Manager — Variables de Entorno
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas .env a control de versiones.
# ══════════════════════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_SECRET_KEY=133eecc32ad8b2177f54b7d6dac0afc24d84e2a6e9528481576c356a62638b23
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# ── Base de Datos ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./neonstream.db

# ── Clave Maestra de Cifrado de Tokens ───────────────────────────────────────
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡GUARDA ESTA CLAVE EN UN LUGAR SEGURO! Perderla = perder todos los tokens.
FERNET_MASTER_KEY=OQkOkogT482wkU3BVPmeJvjAYpHqTa2DK3MMnZkCwkg=

# ── IA: Google Gemini ─────────────────────────────────────────────────────────
# Portal: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── LinkedIn (PoC — Fase 1) ───────────────────────────────────────────────────
# Portal: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=TU_CLIENT_ID
LINKEDIN_CLIENT_SECRET=TU_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback
LINKEDIN_SCOPES=openid,profile,email,w_member_social

# ── X / Twitter (Fase 2) ─────────────────────────────────────────────────────
# Portal: https://developer.twitter.com/en/portal
X_CLIENT_ID=TU_CLIENT_ID
X_CLIENT_SECRET=TU_CLIENT_SECRET
X_REDIRECT_URI=http://127.0.0.1:8000/auth/x/callback

# ── Meta / Instagram (Fase 3) ────────────────────────────────────────────────
# Portal: https://developers.facebook.com/apps/
META_APP_ID=TU_APP_ID
META_APP_SECRET=TU_APP_SECRET
META_REDIRECT_URI=http://127.0.0.1:8000/auth/meta/callback

# ── TikTok (Fase 4) ───────────────────────────────────────────────────────────
# Portal: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=TU_CLIENT_KEY
TIKTOK_CLIENT_SECRET=TU_CLIENT_SECRET
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/auth/tiktok/callback
